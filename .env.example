# Local development values. Production requires an explicit HTTPS frontend origin.
MARKETMIND_ENV=development
MARKETMIND_ARTIFACT_ROOT=.
MARKETMIND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MARKETMIND_LOG_LEVEL=INFO
MARKETMIND_MAX_CONCURRENT_REQUESTS=4
MARKETMIND_MAX_BODY_BYTES=16777216
MARKETMIND_INFERENCE_QUEUE_TIMEOUT_SECONDS=0.25
MARKETMIND_RATE_LIMIT_OPERATIONS=60
MARKETMIND_RATE_LIMIT_STANDARD=10
MARKETMIND_RATE_LIMIT_EXPENSIVE=6
MARKETMIND_RATE_LIMIT_RETURN_RISK=3
MARKETMIND_RATE_LIMIT_WINDOW_SECONDS=60
# PORT is assigned by the hosting provider; the documented local fallback is 8000.
